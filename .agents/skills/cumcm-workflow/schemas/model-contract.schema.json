{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Lucasuiii/modeling-workbench/main/.agents/skills/cumcm-workflow/schemas/model-contract.schema.json",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    }
  ],
  "type": "object",
  "required": [
    "components",
    "selection_check"
  ],
  "properties": {
    "artifact_type": {
      "const": "model_contract"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "model_id",
          "capability_ids",
          "method",
          "scope"
        ],
        "properties": {
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "capability_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "variables": {
            "type": "array",
            "minItems": 1
          },
          "inputs": {
            "type": "array",
            "minItems": 1
          },
          "outputs": {
            "type": "array",
            "minItems": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "verification_plan": {
            "type": "array",
            "minItems": 1
          },
          "strong_claims": {
            "type": "array"
          },
          "candidates": {
            "type": "array",
            "description": "Candidate models under comparison. A candidate says why it is worth considering and what evidence would tell it apart from the others, so the choice can later be justified by exploratory runs instead of by assertion.",
            "items": {
              "type": "object",
              "required": [
                "candidate_id",
                "method",
                "why_considered",
                "discriminating_evidence",
                "status"
              ],
              "properties": {
                "candidate_id": {
                  "type": "string",
                  "minLength": 1
                },
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "why_considered": {
                  "type": "string",
                  "minLength": 1
                },
                "discriminating_evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "What observation would separate this candidate from the others."
                },
                "status": {
                  "enum": [
                    "under_evaluation",
                    "selected",
                    "rejected"
                  ]
                },
                "evaluation_run_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "decision_rationale": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true,
        "description": "Draft contracts carry method and scope only; variables, inputs, outputs and verification_plan become mandatory when the project enters finalizing (enforced by check_model, not by this schema)."
      }
    },
    "selection_check": {
      "type": "object",
      "description": "The person confirms the model choice while nothing has been computed yet, so a rejection here is free. presented_candidate_ids records which alternatives were actually put in front of them.",
      "required": [
        "decision",
        "reviewer",
        "reviewed_at",
        "reviewer_kind",
        "presented_candidate_ids",
        "notes"
      ],
      "properties": {
        "decision": {
          "enum": [
            "unreviewed",
            "accepted",
            "revision_requested"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewer_kind": {
          "enum": [
            "human_user",
            "same_context_model"
          ]
        },
        "presented_candidate_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
