{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Lucasuiii/modeling-workbench/main/.agents/skills/cumcm-workflow/schemas/task-capabilities.schema.json",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    }
  ],
  "type": "object",
  "required": [
    "capabilities"
  ],
  "properties": {
    "artifact_type": {
      "const": "task_capabilities"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "capability_id",
          "subproblem_id",
          "objective",
          "required_output",
          "fact_ids",
          "acceptance_checks",
          "model_ids",
          "code_entry_points",
          "result_ids",
          "lifecycle_state",
          "blocking_issues"
        ],
        "properties": {
          "capability_id": {
            "type": "string",
            "minLength": 1
          },
          "subproblem_id": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "required_output": {
            "type": "string",
            "minLength": 1
          },
          "fact_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance_checks": {
            "type": "array",
            "minItems": 1,
            "description": "How this capability is judged to have been delivered, not merely attempted. A check judged `recorded` names an assertion the solving program itself must write out, so 'we did the task' becomes a runtime fact instead of a claim. A check judged `human` is a semantic question no script can settle and goes to the reviewer.",
            "items": {
              "type": "object",
              "required": [
                "check_id",
                "assertion",
                "judge"
              ],
              "properties": {
                "check_id": {
                  "type": "string",
                  "minLength": 1
                },
                "assertion": {
                  "type": "string",
                  "minLength": 1,
                  "description": "One sentence saying what counts as having done it and what state means it was not done. Write it so the program can raise on it: 'the enumerated minimum equals the dynamic-program bound to 1e-9; otherwise the enumeration missed a policy'."
                },
                "judge": {
                  "enum": [
                    "recorded",
                    "human"
                  ]
                },
                "assertion_name": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Required when judge is `recorded`: the assertion name an official run for this capability must carry, written by the program through record_run.py --assert-file."
                }
              },
              "additionalProperties": true
            }
          },
          "model_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "code_entry_points": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "result_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lifecycle_state": {
            "enum": [
              "planned",
              "implemented",
              "executed",
              "validated",
              "blocked"
            ]
          },
          "blocking_issues": {
            "type": "array"
          }
        },
        "additionalProperties": true
      }
    }
  }
}
