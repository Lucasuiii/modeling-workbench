{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Lucasuiii/modeling-workbench/main/.agents/skills/cumcm-workflow/schemas/delivery-manifest.schema.json",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    }
  ],
  "type": "object",
  "required": [
    "source_policy",
    "deliverables",
    "files",
    "compile",
    "unresolved_errors",
    "accepted_exceptions",
    "excluded_files",
    "final_check"
  ],
  "properties": {
    "artifact_type": {
      "const": "delivery_manifest"
    },
    "source_policy": {
      "type": "object",
      "required": [
        "mode",
        "network_lookup_performed",
        "missing_user_materials"
      ],
      "properties": {
        "mode": {
          "const": "user_supplied_only"
        },
        "network_lookup_performed": {
          "const": false
        },
        "missing_user_materials": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "deliverables": {
      "type": "object",
      "required": [
        "final_pdf",
        "editable_latex_source",
        "computation_source"
      ],
      "properties": {
        "final_pdf": {
          "$ref": "#/$defs/deliverable"
        },
        "editable_latex_source": {
          "$ref": "#/$defs/deliverable"
        },
        "computation_source": {
          "$ref": "#/$defs/deliverable"
        }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "role",
          "size"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "final_pdf",
              "editable_latex_source",
              "computation_source",
              "documentation",
              "supporting_evidence",
              "submission_package"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "compile": {
      "type": "object",
      "required": [
        "command",
        "engine",
        "exit_code",
        "log_path",
        "warnings",
        "page_count"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "engine": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": "integer"
        },
        "log_path": {
          "type": "string",
          "minLength": 1
        },
        "warnings": {
          "type": "array"
        },
        "page_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "unresolved_errors": {
      "type": "array"
    },
    "accepted_exceptions": {
      "type": "array"
    },
    "excluded_files": {
      "type": "array"
    },
    "final_check": {
      "type": "object",
      "description": "The single approval before submission. presented_pages is the machine fact of what was put in front of the reviewer; human_user is not claimable without it.",
      "required": [
        "decision",
        "reviewer",
        "reviewed_at",
        "reviewer_kind",
        "presented_pages",
        "notes"
      ],
      "properties": {
        "decision": {
          "enum": [
            "unreviewed",
            "accepted",
            "revision_requested"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewer_kind": {
          "enum": [
            "human_user",
            "same_context_model"
          ]
        },
        "presented_pages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "submission": {
      "type": "object",
      "required": [
        "rules"
      ],
      "properties": {
        "rules": {
          "type": "object",
          "required": [
            "sources",
            "pdf_name",
            "cover_pages",
            "identity_tokens",
            "abstract",
            "attachments"
          ],
          "properties": {
            "sources": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "pdf_name": {
              "type": "string",
              "minLength": 1
            },
            "cover_pages": {
              "type": "integer",
              "minimum": 1
            },
            "identity_tokens": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "abstract": {
              "type": "object",
              "required": [
                "start_marker",
                "body_marker",
                "max_pages"
              ],
              "properties": {
                "start_marker": {
                  "type": "string",
                  "minLength": 1
                },
                "body_marker": {
                  "type": "string",
                  "minLength": 1
                },
                "max_pages": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            },
            "attachments": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "name",
                  "max_bytes",
                  "formats"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "max_bytes": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "formats": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "zip",
                        "rar",
                        "7z"
                      ]
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "recorded": {
          "type": "object",
          "description": "Written by submission_check.py; checker recomputes and compares every measured field."
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "deliverable": {
      "type": "object",
      "required": [
        "path",
        "entrypoint",
        "editable"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1
        },
        "editable": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  }
}
