{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Lucasuiii/modeling-workbench/main/.agents/skills/cumcm-workflow/schemas/common.schema.json",
  "$defs": {
    "producer": {
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human",
            "codex",
            "script",
            "external_tool"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "review": {
      "type": "object",
      "required": [
        "decision",
        "reviewer",
        "reviewed_at",
        "scope",
        "notes"
      ],
      "properties": {
        "decision": {
          "enum": [
            "unreviewed",
            "accepted",
            "accepted_with_concerns",
            "revision_requested"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "envelope": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_type",
        "project_id",
        "updated_at",
        "producer"
      ],
      "properties": {
        "schema_version": {
          "const": "0.6.0"
        },
        "artifact_type": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "updated_at": {
          "type": "string",
          "minLength": 1
        },
        "producer": {
          "$ref": "#/$defs/producer"
        }
      },
      "description": "Formal approval lives in .cumcm/decisions.jsonl, not in a per-artifact review field."
    },
    "evidence_state": {
      "enum": [
        "not_checked",
        "missing_evidence",
        "supported_not_reproduced",
        "reproduced",
        "partially_supported",
        "contradicted",
        "ambiguous",
        "not_applicable"
      ]
    }
  }
}
