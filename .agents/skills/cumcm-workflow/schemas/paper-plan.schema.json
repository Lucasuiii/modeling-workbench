{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Lucasuiii/modeling-workbench/main/.agents/skills/cumcm-workflow/schemas/paper-plan.schema.json",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    }
  ],
  "type": "object",
  "required": [
    "claim_selection",
    "representation_plan",
    "paper_structure",
    "authoring_task_ref"
  ],
  "properties": {
    "artifact_type": {
      "const": "paper_plan"
    },
    "claim_selection": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "subproblem_id",
          "purpose"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "subproblem_id": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "representation_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item_id",
          "claim_ids",
          "medium",
          "purpose"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "claim_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "result_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "medium": {
            "enum": [
              "prose",
              "equation",
              "table",
              "figure"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "artifact_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "paper_structure": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "section_id",
          "title",
          "purpose",
          "subproblem_ids",
          "claim_ids"
        ],
        "properties": {
          "section_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "subproblem_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": true
      }
    },
    "authoring_task_ref": {
      "type": [
        "string",
        "null"
      ],
      "description": "Task/conversation writing the paper. Must differ from the validation-paper handoff's producing_task_ref."
    }
  }
}
