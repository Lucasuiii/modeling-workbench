{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Lucasuiii/modeling-workbench/main/.agents/skills/cumcm-workflow/schemas/paper-quality-report.schema.json",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    }
  ],
  "type": "object",
  "required": [
    "paper_status",
    "paper_artifact",
    "open_issues",
    "content_report",
    "layout_report"
  ],
  "properties": {
    "artifact_type": {
      "const": "paper_quality_report"
    },
    "paper_status": {
      "enum": [
        "technical_draft",
        "candidate",
        "final"
      ]
    },
    "paper_artifact": {
      "$ref": "#/$defs/artifact"
    },
    "open_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "issue_id",
          "severity",
          "category",
          "status",
          "description",
          "location"
        ],
        "properties": {
          "issue_id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "category": {
            "enum": [
              "content",
              "evidence",
              "derivation",
              "validation",
              "layout",
              "compile",
              "reader_language",
              "numerical_presentation",
              "internal_metadata",
              "other"
            ]
          },
          "status": {
            "enum": [
              "open",
              "closed",
              "accepted_exception"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "resolution": {
            "type": [
              "string",
              "null"
            ]
          },
          "verified_by": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "content_report": {
      "type": "object",
      "required": [
        "artifact",
        "summary",
        "questions"
      ],
      "properties": {
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "subproblem_id",
              "status",
              "notes"
            ],
            "properties": {
              "subproblem_id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "pass",
                  "concern",
                  "fail"
                ]
              },
              "notes": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true,
      "description": "What the paper says per subproblem. A report the writer produces, not an approval."
    },
    "layout_report": {
      "type": "object",
      "required": [
        "artifact",
        "page_count",
        "rendered_pages",
        "checks"
      ],
      "properties": {
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "page_count": {
          "type": "integer",
          "minimum": 1
        },
        "rendered_pages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "check_id",
              "category",
              "status",
              "notes"
            ],
            "properties": {
              "check_id": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "enum": [
                  "heading",
                  "equation",
                  "table",
                  "figure",
                  "caption",
                  "whitespace",
                  "pagination",
                  "cross_page",
                  "font_glyph",
                  "other"
                ]
              },
              "status": {
                "enum": [
                  "pass",
                  "fail",
                  "not_applicable"
                ]
              },
              "notes": {
                "type": "string",
                "minLength": 1
              },
              "artifact": {
                "$ref": "#/$defs/artifact",
                "description": "PDF actually examined by a preserved non-recorder check; a stale binding requires renewed review."
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true,
      "description": "Machine layout facts from record_compile.py. A report, not an approval."
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  }
}
