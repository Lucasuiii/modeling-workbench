{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Lucasuiii/modeling-workbench/main/.agents/skills/cumcm-workflow/schemas/run-manifest.schema.json",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    }
  ],
  "type": "object",
  "required": [
    "run_id",
    "purpose",
    "capability_ids",
    "argv",
    "working_directory",
    "started_at",
    "finished_at",
    "exit_code",
    "status",
    "official_run",
    "implementation",
    "inputs",
    "outputs",
    "environment",
    "stdout_path",
    "stderr_path",
    "assertions"
  ],
  "properties": {
    "artifact_type": {
      "const": "run_manifest"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "subproblem_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "capability_ids": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string"
      }
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "working_directory": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "finished_at": {
      "type": "string",
      "minLength": 1
    },
    "exit_code": {
      "type": "integer"
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "interrupted"
      ]
    },
    "official_run": {
      "type": "boolean"
    },
    "implementation": {
      "type": "object",
      "required": [
        "selected_language",
        "selection_rationale",
        "entry_point",
        "runtime",
        "dependencies",
        "source_snapshot"
      ],
      "properties": {
        "selected_language": {
          "enum": [
            "matlab",
            "python"
          ]
        },
        "selection_rationale": {
          "type": "string",
          "minLength": 1
        },
        "entry_point": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "matlab_toolboxes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fallback_from": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "matlab",
            "python",
            null
          ]
        },
        "source_snapshot": {
          "type": "object",
          "required": [
            "algorithm",
            "digest",
            "files"
          ],
          "properties": {
            "algorithm": {
              "const": "sha256-tree-v1"
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "entrypoint": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/input_file_record"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/output_file_record"
      }
    },
    "environment": {
      "type": "object"
    },
    "stdout_path": {
      "type": "string",
      "minLength": 1
    },
    "stderr_path": {
      "type": "string",
      "minLength": 1
    },
    "assertions": {
      "type": "array"
    },
    "parent_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "candidate_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Model candidates this run was evaluating. Exploratory runs use this to earn a selection."
    },
    "seeds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "value"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {},
          "source": {
            "const": "declared",
            "description": "Caller metadata; not proof that the model used this seed. Missing on older records also means unverified."
          }
        },
        "additionalProperties": true
      },
      "description": "Caller-declared seed metadata only; no assertion that the program received or used it. Reruns inherit declarations, not observed RNG state."
    }
  },
  "$defs": {
    "input_file_record": {
      "type": "object",
      "required": [
        "path",
        "size",
        "media_type",
        "evidence_role"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": "string"
        },
        "evidence_role": {
          "enum": [
            "formal_input",
            "auxiliary_input"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_role": {
                "const": "formal_input"
              }
            },
            "required": [
              "evidence_role"
            ]
          },
          "then": {
            "required": [
              "sha256"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "output_file_record": {
      "type": "object",
      "required": [
        "path",
        "size",
        "media_type",
        "evidence_role"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": "string"
        },
        "evidence_role": {
          "enum": [
            "claim_bearing_output",
            "intermediate_output",
            "diagnostic_output"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_role": {
                "const": "claim_bearing_output"
              }
            },
            "required": [
              "evidence_role"
            ]
          },
          "then": {
            "required": [
              "sha256"
            ]
          }
        }
      ],
      "additionalProperties": true
    }
  }
}
