{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Lucasuiii/modeling-workbench/main/.agents/skills/cumcm-workflow/schemas/paper-revision-log.schema.json",
  "allOf": [{"$ref": "common.schema.json#/$defs/envelope"}],
  "type": "object",
  "required": ["initial_snapshot", "revisions"],
  "properties": {
    "artifact_type": {"const": "paper_revision_log"},
    "initial_snapshot": {"$ref": "#/$defs/snapshot"},
    "revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["revision_id", "created_at", "input", "output", "issue_ids", "changes", "verification"],
        "properties": {
          "revision_id": {"type": "string", "minLength": 1},
          "created_at": {"type": "string", "minLength": 1},
          "input": {"$ref": "#/$defs/snapshot"},
          "output": {"$ref": "#/$defs/snapshot"},
          "issue_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "changes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["location", "summary"],
              "properties": {
                "location": {"type": "string", "minLength": 1},
                "summary": {"type": "string", "minLength": 1}
              },
              "additionalProperties": true
            }
          },
          "verification": {
            "type": "object",
            "required": ["decision", "reviewer", "reviewed_at", "notes"],
            "properties": {
              "decision": {"enum": ["unreviewed", "accepted", "revision_requested"]},
              "reviewer": {"type": ["string", "null"]},
              "reviewed_at": {"type": ["string", "null"]},
              "notes": {"type": ["string", "null"]}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  }
}
